# GEMINI_API_KEY: Required for Gemini AI API calls (Quick Extract PDF & Smart Assistant).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SESSION_SECRET: Secret key used to sign multi-auth session tokens.
AUTH_SESSION_SECRET="CHANGE_ME_LOCAL_SESSION_SECRET"
